# ============================================================
# BabySoC Timing Constraints
# Week 4 - Static Timing Analysis using OpenSTA
# Technology: SKY130
# ============================================================

# CPU clock generated by the PLL
# Frequency: 40 MHz
# Period: 25 ns

create_clock -name pll_clk -period 25.0 [get_pins pll/CLK]

# Clock uncertainty: 0.5 ns
# Preliminary assumption for workshop analysis
set_clock_uncertainty 0.5 [get_clocks pll_clk]

# Clock transition: 0.1 ns
# Preliminary assumption
set_clock_transition 0.1 [get_clocks pll_clk]

# Reset is sampled by a clocked register in the synthesized netlist.
# Reset enters a synchronous flip-flop at _7995_/D
# Preliminary input delay assumption for STA
set_input_delay -clock pll_clk -max 1.0 [get_ports reset]
set_input_delay -clock pll_clk -min 0.0 [get_ports reset]

# DAC analog output is excluded from digital STA.
# The DAC Liberty model has no digital-to-output timing arcs.
set_false_path -to [get_ports OUT]

# ============================================================
# End of BabySoC Timing Constraints
# ============================================================
